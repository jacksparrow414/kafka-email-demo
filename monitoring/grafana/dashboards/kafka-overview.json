    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "KIP-714 客户端遥测: 消费者offset提交延迟与失败rebalance总数",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "avg by (clientId) (org_apache_kafka_consumer_coordinator_commit_latency_avg)", "legendFormat": "commit-latency-avg {{clientId}}", "refId": "A" },
        { "expr": "sum(org_apache_kafka_consumer_coordinator_failed_rebalance_total)", "legendFormat": "failed-rebalance-total", "refId": "B" }
      ],
      "title": "Consumer Commit Latency / Failed Rebalance",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "broker JMX: 每秒写入的消息数",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },

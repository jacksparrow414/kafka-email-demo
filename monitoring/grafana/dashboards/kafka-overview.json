      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "sum by (clientId) (org_apache_kafka_consumer_fetch_manager_fetch_rate)", "legendFormat": "{{clientId}}", "refId": "A" } ],
      "title": "Consumer Fetch Rate (fetch/s)",

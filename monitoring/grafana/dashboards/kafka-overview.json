      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "max by (clientId) (org_apache_kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "{{clientId}}", "refId": "A" } ],

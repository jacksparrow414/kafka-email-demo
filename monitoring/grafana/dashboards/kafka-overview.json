      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "KIP-714 客户端遥测: 生产者每秒发送的消息数",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "sum by (clientId) (org_apache_kafka_producer_record_send_rate)", "legendFormat": "{{clientId}}", "refId": "A" } ],
      "title": "Producer Record Send Rate (msg/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "KIP-714 客户端遥测: 生产者每秒发送失败的消息数",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },

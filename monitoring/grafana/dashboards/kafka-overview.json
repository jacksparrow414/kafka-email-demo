      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "sum by (clientId) (org_apache_kafka_producer_record_error_rate)", "legendFormat": "{{clientId}}", "refId": "A" } ],
      "title": "Producer Record Error Rate (err/s)",
